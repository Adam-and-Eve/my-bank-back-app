{
  "realm": "my-bank-realm",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Regular bank user" },
      { "name": "ACCOUNT_READ", "description": "Permission to read account" },
      { "name": "ACCOUNT_WRITE", "description": "Permission to update account" },
      { "name": "CASH_WRITE", "description": "Permission to perform cash operation" },
      { "name": "TRANSFER_WRITE", "description": "Permission to perform transfer" },
      { "name": "SERVICE", "description": "Generic service role for microservices" },
      { "name": "ACCOUNT_INTERNAL", "description": "Permission to call internal account API" },
      { "name": "NOTIFICATION_WRITE", "description": "Permission to create notification" },
      { "name": "EXCHANGE_GENERATOR", "description": "Permission to update exchange rates" }
    ]
  },
  "clients": [
    {
      "clientId": "front-ui-service",
      "name": "Front UI Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_FRONT_UI_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${BANK_PUBLIC_BASE_URL}/login/oauth2/code/*"],
      "baseUrl": "${BANK_PUBLIC_BASE_URL}",
      "webOrigins": ["${BANK_PUBLIC_BASE_URL}"],
      "attributes": {
        "post.logout.redirect.uris": "${BANK_PUBLIC_BASE_URL}/"
      },
      "defaultClientScopes": ["web-origins", "role_list", "profile", "email", "roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "cash-service",
      "name": "Cash Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_CASH_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_TRANSFER_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "account-service",
      "name": "Account Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_ACCOUNT_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "notification-service",
      "name": "Notification Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_NOTIFICATION_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "exchange-generator-service",
      "name": "Exchange Generator Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BANK_SERVICES_EXCHANGE_GENERATOR_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
